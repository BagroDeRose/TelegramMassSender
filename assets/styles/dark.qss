/* TelegramMassSender -- dark theme.
   Design goals: modern, minimal, Windows 10/11-friendly, a muted accent
   loosely adjacent to Telegram's blue (not a copy, not neon), consistent
   radii/spacing/typography, and clear button states (hover/disabled/
   active/primary/danger). */

* {
    color: #e6e6e6;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget {
    background-color: #1b1c1f;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ---- Section cards ------------------------------------------------- */

QGroupBox#sectionCard {
    background-color: #232427;
    border: 1px solid #34363b;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 14px 12px 14px;
}

QGroupBox#sectionCard::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 0 6px;
    color: #f0f1f3;
    font-weight: 600;
    font-size: 14px;
    background-color: #1b1c1f;
}

/* Smaller nested group boxes (interval / test-send / stats inside the
   "Рассылка" card) get a lighter, flatter treatment so they read as
   subsections, not a second layer of cards. */
QGroupBox {
    border: 1px solid #34363b;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: 600;
    color: #cfd1d4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #a9abb0;
    font-weight: 600;
}

/* ---- Buttons --------------------------------------------------------- */

QPushButton, QToolButton {
    background-color: #2b2d31;
    border: 1px solid #3d3f45;
    border-radius: 7px;
    padding: 7px 14px;
    color: #e6e6e6;
}

QPushButton:hover, QToolButton:hover {
    background-color: #34363c;
    border-color: #4a4d54;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #26282b;
}

QPushButton:disabled, QToolButton:disabled {
    color: #63656b;
    background-color: #212226;
    border-color: #2c2d31;
}

QToolButton:checkable:checked {
    background-color: #2c4a6b;
    border-color: #4ea1f7;
    color: #ffffff;
}

QPushButton#primaryButton {
    background-color: #2f6fb3;
    border-color: #3a7ec4;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #3a7ec4;
}

QPushButton#primaryButton:pressed {
    background-color: #2a629f;
}

QPushButton#primaryButton:disabled {
    background-color: #2a2e33;
    border-color: #2c2d31;
    color: #63656b;
}

QPushButton#dangerButton {
    background-color: #2b2d31;
    border-color: #5c3336;
    color: #e6989b;
}

QPushButton#dangerButton:hover {
    background-color: #46282a;
    border-color: #a34a4f;
    color: #ffb3b6;
}

QPushButton#dangerButton:disabled {
    color: #63656b;
    border-color: #2c2d31;
    background-color: #212226;
}

/* ---- Inputs ------------------------------------------------------------ */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox, QListWidget, QTextBrowser {
    background-color: #202124;
    border: 1px solid #3a3b3e;
    border-radius: 7px;
    padding: 5px 7px;
    selection-background-color: #2f6fb3;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #4ea1f7;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: #63656b;
    background-color: #1d1e21;
    border-color: #2c2d31;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QListWidget::item {
    padding: 4px 3px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #2f6fb3;
}

/* ---- Progress / status -------------------------------------------------- */

QProgressBar {
    background-color: #202124;
    border: 1px solid #3a3b3e;
    border-radius: 7px;
    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #4ea1f7;
    border-radius: 6px;
}

QLabel {
    color: #cfd1d4;
}

QLabel#summaryLabel {
    color: #9a9da3;
    font-size: 12px;
}

QLabel#statusLabel {
    color: #e0a94e;
    font-weight: 600;
}

QLabel#charCountLabel {
    color: #7d7f85;
    font-size: 12px;
}

QLabel#attachmentsPreviewLabel {
    color: #9a9da3;
    font-size: 12px;
}

QStatusBar {
    background-color: #17181a;
    color: #9a9da3;
    border-top: 1px solid #2c2d31;
}

/* ---- Scrollbars --------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3a3b3e;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4d54;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #3a3b3e;
    border-radius: 5px;
    min-width: 24px;
}

/* ---- Dialogs -------------------------------------------------------------- */

QDialog {
    background-color: #1b1c1f;
}

QMessageBox QLabel {
    color: #e6e6e6;
}
